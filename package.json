{
  "name": "url-shortener",
  "version": "1.0.0",
  "private": true,
  "description": "URL shortener with click analytics, Redis caching and rate limiting",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "ui": "node scripts/ui.js",
    "migrate": "node src/db/migrate.js",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0"
  }
}
