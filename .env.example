PORT=3000
# Base used to build short URLs returned by the API
BASE_URL=http://localhost:3000

DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener
REDIS_URL=redis://localhost:6379

# Cache
CACHE_TTL_SECONDS=3600
# Negative cache: how long a "code does not exist" answer is remembered
NEGATIVE_CACHE_TTL_SECONDS=60

# Rate limiting (sliding window, per IP, applied to writes)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=20

# Length of generated short codes
CODE_LENGTH=7
